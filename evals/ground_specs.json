{
  "version": "ground-v1",
  "note": "Páginas + alvos. A caixa de cada alvo vem da DOM/JS NA CAPTURA e nunca é enviada ao modelo. Alvo com absent=true não existe na página: a resposta correta é null.",
  "pages": [
    {
      "id": "canvas",
      "file": "pages/canvas-ui.html",
      "category": "canvas-sem-dom",
      "viewport": [
        1280,
        800
      ],
      "targets": [
        {
          "instruction": "Click the 'Exportar vídeo' button",
          "js": "window.__t.exportar"
        },
        {
          "instruction": "Clique no botão Cortar clipe",
          "js": "window.__t.cortar"
        },
        {
          "instruction": "Click the red Excluir button",
          "js": "window.__t.excluir"
        },
        {
          "instruction": "Click the green play button",
          "js": "window.__t.reproduzir"
        },
        {
          "instruction": "Click the 'Checkout' button",
          "absent": true
        }
      ]
    },
    {
